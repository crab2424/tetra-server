# deploy/oci-a1-retry.sh の設定．~/.config/oci-a1-retry.env にコピーして編集する．
# OCID はコンソールのインスタンス詳細などからコピーできる．

# 必須
COMPARTMENT_ID="ocid1.tenancy.oc1..xxxx"      # 既定ではルート compartment = テナンシ OCID
SUBNET_ID="ocid1.subnet.oc1.ap-tokyo-1.xxxx"  # tetlabo Micro と同じサブネット（インスタンス詳細 → Primary VNIC → Subnet）
SSH_PUBKEY_FILE="$HOME/.ssh/tetlabo_a1.pub"   # 新インスタンスに登録する SSH 公開鍵

# 任意（既定値）
# DISPLAY_NAME="tetlabo-a1"
# OCPUS=1
# MEMORY_GB=6
# BOOT_VOLUME_GB=50          # ストレージ無料枠は全インスタンス合計 200GB
# INTERVAL_SEC=120
# AVAILABILITY_DOMAIN=""     # 空なら自動
# IMAGE_ID=""                # 空なら Ubuntu 24.04 aarch64 の最新
# NTFY_TOPIC=""              # 例: 推測されにくいランダム文字列．スマホの ntfy アプリで購読すると通知が届く
